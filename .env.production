# Used by `npm run build` (Cloudflare builds). Committed on purpose: VITE_* values
# are bundled into the public JS, so nothing here may be secret.

# Kanak backend API on the UAT EC2 box
VITE_API_BASE_URL=http://18.119.106.180/api/v1

# Leave VITE_PUBLIC_SITE_URL unset so links use the site's own origin
# (window.location.origin), whatever Cloudflare URL it is served from.

# Must match the backend's PAYMENT_GATEWAY=sandbox
VITE_PAYMENT_SANDBOX=true
