# Used by `npm run build` (Cloudflare builds). Committed on purpose: VITE_* values
# are bundled into the public JS, so nothing here may be secret.

# Production Kanak backend API (EC2, see docs/production-runbook.html). Must be https:
# the site is served over https and browsers block http API calls (mixed content).
# UAT was https://18-119-106-180.sslip.io/api/v1
VITE_API_BASE_URL=https://api.kanakbeautyservice.com/api/v1

# Public website address, used to build certificate verification and referral links.
VITE_PUBLIC_SITE_URL=https://kanakbeautyservice.com

# Production uses Razorpay (backend PAYMENT_GATEWAY=razorpay): no sandbox controls.
VITE_PAYMENT_SANDBOX=false
