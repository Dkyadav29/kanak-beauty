{
  "name": "kanak-beauty-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kanak Beauty Service — professional beauty training platform (React + Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "site:on": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/site.ps1 on",
    "site:off": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/site.ps1 off",
    "site:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/site.ps1 status"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@tanstack/react-query": "^5.80.0",
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.18.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.58.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.153.0"
  }
}
